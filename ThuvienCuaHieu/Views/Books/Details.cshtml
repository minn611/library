@model ThuvienCuaHieu.ViewModels.BookDetailVM
@{
    ViewData["Title"] = Model.Book.Title;
}

<div class="container py-5">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-teal-dk text-decoration-none">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Books" asp-action="Index" class="text-teal-dk text-decoration-none">Thư Viện</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Book.Title</li>
        </ol>
    </nav>

    <!-- Error/Success alerts -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fa-solid fa-circle-xmark me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Book Panel -->
    <div class="row g-4 mb-5">
        <!-- Cột Trái: Ảnh bìa & Nút bấm mượn sách -->
        <div class="col-md-4 text-center">
            <div class="detail-cover mb-4">
                <img src="@Model.Book.CoverImageUrl" alt="@Model.Book.Title" class="img-fluid rounded-3" style="width: 100%; max-height: 480px; object-fit: cover;" onerror="this.src='https://covers.openlibrary.org/b/id/10527843-M.jpg'" />
            </div>

            <!-- Action buttons -->
            <div class="d-flex flex-column gap-3">
                <!-- Borrow book form -->
                <form asp-controller="Borrow" asp-action="RequestBorrow" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookId" value="@Model.Book.BookId" />
                    
                    @if (Model.Book.AvailableQty > 0)
                    {
                        <button type="submit" class="btn btn-peach w-100 py-3 fs-5 d-flex align-items-center justify-content-center gap-2">
                            <i class="fa-solid fa-hand-holding-hand"></i> Mượn Sách Vật Lý
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary w-100 py-3 fs-5 d-flex align-items-center justify-content-center gap-2" disabled>
                            <i class="fa-solid fa-circle-exclamation"></i> Đã Hết Sách Tạm Thời
                        </button>
                    }
                </form>

                <!-- Wishlist toggle form -->
                <form asp-controller="Borrow" asp-action="ToggleWishlist" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookId" value="@Model.Book.BookId" />
                    
                    @if (Model.IsInWishlist)
                    {
                        <button type="submit" class="btn btn-outline-danger w-100 py-2 fs-6 d-flex align-items-center justify-content-center gap-2" style="border-radius: 30px;">
                            <i class="fa-solid fa-heart-crack"></i> Xóa Khỏi Yêu Thích
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-outline-teal w-100 py-2 fs-6 d-flex align-items-center justify-content-center gap-2" style="border-radius: 30px;">
                            <i class="fa-regular fa-heart text-danger"></i> Thêm Vào Yêu Thích
                        </button>
                    }
                </form>
            </div>
        </div>

        <!-- Cột Phải: Thông tin sách -->
        <div class="col-md-8">
            <div class="detail-info">
                <span class="badge bg-mint text-teal-dk fs-7 mb-2 px-3 py-1 border border-secondary border-opacity-10 rounded-pill">@Model.Book.Category?.Name</span>
                <h1 class="display-5 mb-2 fw-bold text-teal-dk" style="font-family: 'Playfair Display', serif;">@Model.Book.Title</h1>
                <p class="fs-4 text-muted mb-4">Bởi tác giả: <span class="text-teal fw-bold">@Model.Book.Author</span></p>

                <!-- Star Rating Summary -->
                <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom">
                    <div class="text-peach fs-5">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Floor(Model.AverageRating))
                            {
                                <i class="fa-solid fa-star"></i>
                            }
                            else if (i - 0.5 <= Model.AverageRating)
                            {
                                <i class="fa-solid fa-star-half-stroke"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-star text-secondary opacity-50"></i>
                            }
                        }
                    </div>
                    <span class="fw-bold fs-5 text-teal-dk ms-1">@Model.AverageRating / 5</span>
                    <span class="text-muted ms-2">(@Model.Reviews.Count đánh giá độc giả)</span>
                    <span class="text-muted ms-3">|</span>
                    <span class="text-muted ms-2"><i class="fa-solid fa-eye me-1"></i> @Model.Book.ViewCount lượt xem</span>
                </div>

                <!-- Parameters list -->
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border border-secondary border-opacity-10">
                            <span class="text-muted d-block fs-7" style="font-size: 0.8rem;">MÃ ISBN</span>
                            <span class="fw-bold text-teal-dk">@(string.IsNullOrEmpty(Model.Book.ISBN) ? "Đang cập nhật" : Model.Book.ISBN)</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border border-secondary border-opacity-10">
                            <span class="text-muted d-block fs-7" style="font-size: 0.8rem;">NHÀ XUẤT BẢN</span>
                            <span class="fw-bold text-teal-dk">@(string.IsNullOrEmpty(Model.Book.Publisher) ? "Đang cập nhật" : Model.Book.Publisher)</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border border-secondary border-opacity-10">
                            <span class="text-muted d-block fs-7" style="font-size: 0.8rem;">NĂM XUẤT BẢN</span>
                            <span class="fw-bold text-teal-dk">@Model.Book.PublishedYear</span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded-3 border border-secondary border-opacity-10">
                            <span class="text-muted d-block fs-7" style="font-size: 0.8rem;">SỐ BẢN TRONG THƯ VIỆN</span>
                            <span class="fw-bold text-teal-dk">Còn lại: @Model.Book.AvailableQty / @Model.Book.TotalQty cuốn sách</span>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Book.SourceUrl))
                {
                    <div class="mt-4">
                        <a href="@Model.Book.SourceUrl" target="_blank" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" style="border-radius: 20px;">
                            <i class="fa-solid fa-up-right-from-square"></i> Tham khảo tại dilib.vn
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Details Tab Section (Mô tả, Đánh giá, Sách liên quan) -->
    <div class="mb-5">
        <!-- Tab Headers -->
        <ul class="nav nav-tabs detail-tabs border-bottom-0" id="bookTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab" aria-controls="desc" aria-selected="true">
                    <i class="fa-solid fa-align-left me-1"></i> Tóm Tắt & Mô Tả
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab" aria-controls="reviews" aria-selected="false">
                    <i class="fa-solid fa-star-half-stroke me-1"></i> Đánh Giá Độc Giả (@Model.Reviews.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="related-tab" data-bs-toggle="tab" data-bs-target="#related" type="button" role="tab" aria-controls="related" aria-selected="false">
                    <i class="fa-solid fa-layer-group me-1"></i> Sách Cùng Thể Loại
                </button>
            </li>
        </ul>

        <!-- Tab Contents -->
        <div class="tab-content detail-tab-content" id="bookTabContent">
            
            <!-- Description Tab -->
            <div class="tab-pane fade show active" id="desc" role="tabpanel" aria-labelledby="desc-tab">
                <h5 class="text-teal-dk fw-bold mb-3" style="font-family: 'Playfair Display', serif; font-size: 1.3rem;">Nội Dung Tóm Tắt</h5>
                <p class="text-muted" style="font-size: 1.05rem; line-height: 1.8; text-align: justify; white-space: pre-line;">
                    @(string.IsNullOrEmpty(Model.Book.Description) ? "Hiện chưa có bài tóm tắt chi tiết cho cuốn sách này. Chúng tôi sẽ cập nhật trong thời gian sớm nhất." : Model.Book.Description)
                </p>
            </div>

            <!-- Reviews Tab -->
            <div class="tab-pane fade" id="reviews" role="tabpanel" aria-labelledby="reviews-tab">
                <h5 class="text-teal-dk fw-bold mb-4" style="font-family: 'Playfair Display', serif; font-size: 1.3rem;">Bình Luận & Đánh Giá</h5>
                
                <!-- Review Input Form (Authenticated users only) -->
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="bg-light p-4 rounded-4 border border-secondary border-opacity-10 mb-5">
                        <h6 class="fw-bold mb-3 text-teal-dk">Viết Đánh Giá Của Bạn</h6>
                        <form asp-action="AddReview" asp-route-id="@Model.Book.BookId" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted" style="font-size: 0.85rem;">Xếp Hạng Sao</label>
                                <div class="rating-stars-input d-flex gap-2 text-warning fs-4">
                                    <input type="hidden" name="rating" id="ratingScore" value="5" />
                                    <i class="fa-solid fa-star star-btn cursor-pointer" data-val="1"></i>
                                    <i class="fa-solid fa-star star-btn cursor-pointer" data-val="2"></i>
                                    <i class="fa-solid fa-star star-btn cursor-pointer" data-val="3"></i>
                                    <i class="fa-solid fa-star star-btn cursor-pointer" data-val="4"></i>
                                    <i class="fa-solid fa-star star-btn cursor-pointer" data-val="5"></i>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="comment" class="form-label fw-bold text-muted" style="font-size: 0.85rem;">Nhận Xét Chi Tiết</label>
                                <textarea name="comment" id="comment" rows="3" class="form-control" style="border-radius: 12px;" placeholder="Hãy chia sẻ suy nghĩ của bạn về cuốn sách này..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-teal">
                                <i class="fa-solid fa-paper-plane me-1"></i> Gửi Đánh Giá
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning rounded-3 border-0 bg-warning bg-opacity-10 p-3 mb-5 text-center" role="alert">
                        <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>
                        <span>Bạn phải <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="fw-bold text-warning">Đăng nhập</a> mới có thể viết đánh giá và xếp hạng cho cuốn sách này!</span>
                    </div>
                }

                <!-- Review list -->
                @if (Model.Reviews.Any())
                {
                    <div class="d-flex flex-column gap-4">
                        @foreach (var rev in Model.Reviews)
                        {
                            <div class="pb-4 border-bottom last-border-none">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(rev.User?.Avatar ?? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=80")" alt="Avatar" class="rounded-circle" style="width: 45px; height: 45px; object-fit: cover;" />
                                        <div>
                                            <h6 class="fw-bold text-teal-dk mb-0">@(rev.User?.FullName ?? "Độc giả ẩn danh")</h6>
                                            <span class="text-muted fs-7">@rev.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    </div>
                                    <div class="text-peach">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= rev.Rating)
                                            {
                                                <i class="fa-solid fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-star text-secondary opacity-50"></i>
                                            }
                                        }
                                    </div>
                                </div>
                                <p class="text-muted ps-5 mb-0" style="font-size: 0.95rem;">@rev.Comment</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa-regular fa-comments fs-3 mb-2 opacity-50"></i>
                        <p class="mb-0">Chưa có bình luận nào cho cuốn sách này. Hãy trở thành người đầu tiên viết đánh giá!</p>
                    </div>
                }
            </div>

            <!-- Related Books Tab -->
            <div class="tab-pane fade" id="related" role="tabpanel" aria-labelledby="related-tab">
                <h5 class="text-teal-dk fw-bold mb-4" style="font-family: 'Playfair Display', serif; font-size: 1.3rem;">Sách Bạn Có Thể Thích</h5>
                
                @if (Model.RelatedBooks.Any())
                {
                    <div class="row g-4">
                        @foreach (var b in Model.RelatedBooks)
                        {
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                <div class="book-card shadow-sm">
                                    <div class="book-card-image" style="height: 180px;">
                                        <img src="@b.CoverImageUrl" alt="@b.Title" style="height: 100%;" onerror="this.src='https://covers.openlibrary.org/b/id/10527843-M.jpg'" />
                                    </div>
                                    <div class="book-card-body p-3">
                                        <h4 class="book-card-title" style="font-size: 1rem;">
                                            <a asp-action="Details" asp-route-id="@b.BookId">@b.Title</a>
                                        </h4>
                                        <p class="book-card-author mb-0" style="font-size: 0.75rem;">@b.Author</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">Hiện không tìm thấy cuốn sách cùng thể loại nào khác.</p>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Interactive Star Rating Form
        $(document).ready(function() {
            $('.star-btn').on('mouseenter', function() {
                var val = $(this).data('val');
                highlightStars(val);
            }).on('mouseleave', function() {
                var currentVal = $('#ratingScore').val();
                highlightStars(currentVal);
            }).on('click', function() {
                var val = $(this).data('val');
                $('#ratingScore').val(val);
                highlightStars(val);
            });

            function highlightStars(count) {
                $('.star-btn').each(function(index) {
                    if (index < count) {
                        $(this).removeClass('fa-regular text-secondary opacity-50').addClass('fa-solid');
                    } else {
                        $(this).removeClass('fa-solid').addClass('fa-regular text-secondary opacity-50');
                    }
                });
            }
        });
    </script>
}
