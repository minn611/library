@{
    ViewData["Title"] = "Từ Chối Truy Cập";
}

<div class="container py-5 text-center my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="bg-white border border-secondary border-opacity-10 rounded-4 shadow p-5">
                <i class="fa-solid fa-hand-holding-hand text-danger fs-1 mb-4" style="font-size: 5rem !important;"></i>
                <h1 class="display-5 text-danger fw-bold mb-3" style="font-family: 'Playfair Display', serif;">Từ Chối Truy Cập!</h1>
                <p class="fs-5 text-muted mb-4">
                    Xin lỗi, tài khoản của bạn không được phép truy cập vào khu vực này. Trang này chỉ dành riêng cho Quản Trị Viên (Admin).
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-teal">Trở Về Trang Chủ</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-teal">Đăng Nhập Khác</a>
                </div>
            </div>
        </div>
    </div>
</div>
