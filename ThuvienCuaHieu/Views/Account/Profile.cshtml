@model ThuvienCuaHieu.Models.User
@{
    ViewData["Title"] = "Hồ Sơ Độc Giả";
    var activeRecords = Model.BorrowRecords.Where(r => r.Status == "Pending" || r.Status == "Approved").OrderByDescending(r => r.RecordId).ToList();
    var historyRecords = Model.BorrowRecords.Where(r => r.Status == "Returned" || r.Status == "Rejected").OrderByDescending(r => r.RecordId).ToList();
    var wishlistItems = Model.Wishlists.ToList();
}

<div class="container py-5">
    <!-- Success notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột Trái: Hồ Sơ Cá Nhân -->
        <div class="col-lg-4">
            <div class="profile-sidebar">
                <img src="@(Model.Avatar ?? "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=200")" alt="Avatar" class="profile-avatar shadow" onerror="this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=200'" />
                <h3 class="fw-bold text-teal-dk mb-1" style="font-family: 'Playfair Display', serif;">@Model.FullName</h3>
                <span class="badge bg-mint text-teal-dk mb-3 px-3 py-1 border border-secondary border-opacity-10 rounded-pill">Độc Giả Thân Thiết</span>
                
                <div class="text-start border-top pt-3 mt-2">
                    <p class="mb-2" style="font-size: 0.9rem;"><strong><i class="fa-regular fa-envelope text-muted me-2"></i> Email:</strong> <span class="text-muted">@Model.Email</span></p>
                    <p class="mb-2" style="font-size: 0.9rem;"><strong><i class="fa-solid fa-phone text-muted me-2"></i> Điện thoại:</strong> <span class="text-muted">@(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</span></p>
                    <p class="mb-2" style="font-size: 0.9rem;"><strong><i class="fa-regular fa-calendar-days text-muted me-2"></i> Ngày đăng ký:</strong> <span class="text-muted">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span></p>
                </div>

                <div class="d-grid mt-4 gap-2">
                    <a asp-action="Logout" class="btn btn-sm btn-outline-danger" style="border-radius: 20px;">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Đăng Xuất Tài Khoản
                    </a>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Thống Kê & Giao dịch mượn trả -->
        <div class="col-lg-8">
            <!-- Stats overview cards -->
            <div class="row g-3 mb-4">
                <div class="col-4">
                    <div class="p-3 bg-white border border-secondary border-opacity-10 rounded-4 shadow-sm text-center">
                        <span class="text-muted d-block fs-7" style="font-size: 0.75rem;">ĐANG MƯỢN</span>
                        <span class="fs-3 fw-bold text-teal-dk">@Model.BorrowRecords.Count(r => r.Status == "Approved")</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-white border border-secondary border-opacity-10 rounded-4 shadow-sm text-center">
                        <span class="text-muted d-block fs-7" style="font-size: 0.75rem;">CHỜ DUYỆT</span>
                        <span class="fs-3 fw-bold text-warning">@Model.BorrowRecords.Count(r => r.Status == "Pending")</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-white border border-secondary border-opacity-10 rounded-4 shadow-sm text-center">
                        <span class="text-muted d-block fs-7" style="font-size: 0.75rem;">YÊU THÍCH</span>
                        <span class="fs-3 fw-bold text-danger">@Model.Wishlists.Count</span>
                    </div>
                </div>
            </div>

            <!-- Profile Nav Tabs -->
            <div class="bg-white border border-secondary border-opacity-10 rounded-4 shadow-sm overflow-hidden">
                <ul class="nav nav-tabs border-bottom-0 bg-light p-2" id="profileTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active px-3 py-2 border-0 fw-bold" style="font-size: 0.95rem; border-radius: 8px;" id="active-tab" data-bs-toggle="tab" data-bs-target="#activeBorrows" type="button" role="tab" aria-controls="activeBorrows" aria-selected="true">
                            <i class="fa-solid fa-clock me-1 text-primary"></i> Sách Đang Mượn
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-3 py-2 border-0 fw-bold" style="font-size: 0.95rem; border-radius: 8px;" id="history-tab" data-bs-toggle="tab" data-bs-target="#borrowHistory" type="button" role="tab" aria-controls="borrowHistory" aria-selected="false">
                            <i class="fa-solid fa-history me-1 text-success"></i> Lịch Sử Mượn Trả
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link px-3 py-2 border-0 fw-bold" style="font-size: 0.95rem; border-radius: 8px;" id="wish-tab" data-bs-toggle="tab" data-bs-target="#wishlist" type="button" role="tab" aria-controls="wishlist" aria-selected="false">
                            <i class="fa-solid fa-heart me-1 text-danger"></i> Sách Yêu Thích
                        </button>
                    </li>
                </ul>

                <div class="tab-content p-4" id="profileTabContent">
                    
                    <!-- Active borrows Tab -->
                    <div class="tab-pane fade show active" id="activeBorrows" role="tabpanel" aria-labelledby="active-tab">
                        @if (activeRecords.Any())
                        {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr class="text-teal-dk">
                                            <th>Ảnh Bìa</th>
                                            <th>Tên Sách</th>
                                            <th>Ngày Hẹn Trả</th>
                                            <th>Trạng Thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in activeRecords)
                                        {
                                            <tr>
                                                <td style="width: 70px;">
                                                    <img src="@record.Book?.CoverImageUrl" alt="Cover" class="rounded shadow-sm border border-secondary border-opacity-10" style="width: 50px; height: 70px; object-fit: cover;" onerror="this.src='https://covers.openlibrary.org/b/id/10527843-M.jpg'" />
                                                </td>
                                                <td>
                                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@record.BookId" class="fw-bold text-teal-dk text-decoration-none">@record.Book?.Title</a>
                                                    <span class="text-muted d-block fs-7" style="font-size: 0.8rem;">Bởi @record.Book?.Author</span>
                                                </td>
                                                <td class="fw-bold">
                                                    @record.DueDate.ToString("dd/MM/yyyy")
                                                    @if (record.Status == "Approved" && DateTime.Now > record.DueDate)
                                                    {
                                                        <span class="badge bg-danger ms-2">Trễ Hạn</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (record.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning bg-opacity-25 text-warning-emphasis py-1 px-3" style="border-radius: 20px;">Chờ Duyệt</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-primary bg-opacity-25 text-primary-emphasis py-1 px-3" style="border-radius: 20px;">Đang Mượn</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fa-regular fa-folder-open fs-3 mb-2 opacity-50"></i>
                                <p class="mb-0">Hiện tại bạn không có cuốn sách nào đang mượn hoặc chờ duyệt.</p>
                            </div>
                        }
                    </div>

                    <!-- History borrows Tab -->
                    <div class="tab-pane fade" id="borrowHistory" role="tabpanel" aria-labelledby="history-tab">
                        @if (historyRecords.Any())
                        {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead>
                                        <tr class="text-teal-dk">
                                            <th>Ảnh Bìa</th>
                                            <th>Tên Sách</th>
                                            <th>Ngày Trả / Từ Chối</th>
                                            <th>Phạt Trễ Hạn</th>
                                            <th>Kết Quả</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in historyRecords)
                                        {
                                            <tr>
                                                <td style="width: 70px;">
                                                    <img src="@record.Book?.CoverImageUrl" alt="Cover" class="rounded shadow-sm border border-secondary border-opacity-10" style="width: 50px; height: 70px; object-fit: cover;" onerror="this.src='https://covers.openlibrary.org/b/id/10527843-M.jpg'" />
                                                </td>
                                                <td>
                                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@record.BookId" class="fw-bold text-teal-dk text-decoration-none">@record.Book?.Title</a>
                                                    <span class="text-muted d-block fs-7" style="font-size: 0.8rem;">Bởi @record.Book?.Author</span>
                                                </td>
                                                <td class="text-muted fs-7">
                                                    @(record.ReturnDate.HasValue ? record.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm") : "Không khả dụng")
                                                </td>
                                                <td>
                                                    @if (record.FineAmount > 0)
                                                    {
                                                        <span class="text-danger fw-bold">@record.FineAmount.ToString("N0") VNĐ</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-success">—</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (record.Status == "Returned")
                                                    {
                                                        <span class="badge bg-success bg-opacity-25 text-success-emphasis py-1 px-3" style="border-radius: 20px;">Đã Trả</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger bg-opacity-25 text-danger-emphasis py-1 px-3" style="border-radius: 20px;">Bị Từ Chối</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fa-regular fa-clock fs-3 mb-2 opacity-50"></i>
                                <p class="mb-0">Bạn chưa có lịch sử mượn trả sách nào trước đây.</p>
                            </div>
                        }
                    </div>

                    <!-- Wishlist Tab -->
                    <div class="tab-pane fade" id="wishlist" role="tabpanel" aria-labelledby="wish-tab">
                        @if (wishlistItems.Any())
                        {
                            <div class="row g-3">
                                @foreach (var item in wishlistItems)
                                {
                                    <div class="col-sm-6">
                                        <div class="p-3 border border-secondary border-opacity-10 rounded-4 d-flex align-items-center gap-3">
                                            <img src="@item.Book?.CoverImageUrl" alt="Cover" class="rounded shadow-sm border" style="width: 50px; height: 75px; object-fit: cover;" onerror="this.src='https://covers.openlibrary.org/b/id/10527843-M.jpg'" />
                                            <div class="flex-grow-1 overflow-hidden">
                                                <h6 class="fw-bold text-teal-dk text-truncate mb-1">
                                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId" class="text-decoration-none text-teal-dk">@item.Book?.Title</a>
                                                </h6>
                                                <p class="text-muted fs-7 text-truncate mb-0">Bởi @item.Book?.Author</p>
                                            </div>
                                            
                                            <!-- Remove form toggle -->
                                            <form asp-controller="Borrow" asp-action="ToggleWishlist" method="post" class="mb-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="bookId" value="@item.BookId" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Xóa khỏi yêu thích">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fa-regular fa-heart fs-3 mb-2 opacity-50"></i>
                                <p class="mb-0">Danh sách sách yêu thích của bạn đang trống.</p>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
