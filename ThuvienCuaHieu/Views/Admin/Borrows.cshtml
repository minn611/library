@model IEnumerable<ThuvienCuaHieu.Models.BorrowRecord>
@{
    ViewData["Title"] = "Duyệt Mượn Trả Sách";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Cột Trái: Sidebar Menu -->
        <div class="col-lg-3">
            <partial name="_AdminSidebar" />
        </div>

        <!-- Cột Phải: Bảng Duyệt Mượn Trả -->
        <div class="col-lg-9">
            
            <!-- Success/Error alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="fa-solid fa-circle-xmark me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Header Panel -->
            <div class="mb-4 pb-2 border-bottom">
                <h2 class="fw-bold text-teal-dk mb-1" style="font-family: 'Playfair Display', serif;">Quản Lý Mượn Trả Sách</h2>
                <p class="text-muted mb-0" style="font-size: 0.9rem;">Duyệt yêu cầu mượn, xác nhận trả sách và tự động tính tiền phạt trễ hạn.</p>
            </div>

            <!-- Borrows Table -->
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle table-custom">
                        <thead>
                            <tr>
                                <th>Độc Giả</th>
                                <th>Đầu Sách</th>
                                <th>Mốc Thời Gian</th>
                                <th>Tiền Phạt</th>
                                <th>Trạng Thái</th>
                                <th class="text-center" style="width: 140px;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-teal-dk d-block">@record.User?.FullName</span>
                                        <span class="text-muted d-block" style="font-size: 0.75rem;"><i class="fa-regular fa-envelope me-1"></i> @record.User?.Email</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-teal-dk d-block">@record.Book?.Title</span>
                                        <span class="text-muted d-block" style="font-size: 0.75rem;">Bản cứng khả dụng: @record.Book?.AvailableQty / @record.Book?.TotalQty</span>
                                    </td>
                                    <td style="font-size: 0.85rem;">
                                        <span class="d-block"><strong>Mượn:</strong> @record.BorrowDate.ToString("dd/MM/yyyy")</span>
                                        <span class="d-block text-danger"><strong>Hạn trả:</strong> @record.DueDate.ToString("dd/MM/yyyy")</span>
                                        @if (record.ReturnDate.HasValue)
                                        {
                                            <span class="d-block text-success"><strong>Đã trả:</strong> @record.ReturnDate.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.FineAmount > 0)
                                        {
                                            <span class="badge bg-danger rounded py-1 px-2">@record.FineAmount.ToString("N0") VNĐ</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.Status == "Pending")
                                        {
                                            <span class="badge bg-warning bg-opacity-25 text-warning-emphasis py-1 px-3" style="border-radius: 20px;">Chờ Duyệt</span>
                                        }
                                        else if (record.Status == "Approved")
                                        {
                                            <span class="badge bg-primary bg-opacity-25 text-primary-emphasis py-1 px-3" style="border-radius: 20px;">Đang Mượn</span>
                                        }
                                        else if (record.Status == "Returned")
                                        {
                                            <span class="badge bg-success bg-opacity-25 text-success-emphasis py-1 px-3" style="border-radius: 20px;">Đã Trả</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-25 text-danger-emphasis py-1 px-3" style="border-radius: 20px;">Từ Chối</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (record.Status == "Pending")
                                        {
                                            <div class="d-flex justify-content-center gap-1">
                                                <form asp-action="ApproveBorrow" asp-route-id="@record.RecordId" method="post" class="mb-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-teal py-1 px-2 fs-7" title="Duyệt cho mượn">
                                                        <i class="fa-solid fa-check me-1"></i> Duyệt
                                                    </button>
                                                </form>
                                                <form asp-action="RejectBorrow" asp-route-id="@record.RecordId" method="post" class="mb-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2 fs-7" title="Từ chối yêu cầu">
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (record.Status == "Approved")
                                        {
                                            <form asp-action="ConfirmReturn" asp-route-id="@record.RecordId" method="post" class="mb-0 d-grid">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-peach py-1 px-3 fs-7" title="Xác nhận khách trả sách">
                                                    <i class="fa-solid fa-arrows-rotate me-1"></i> Xác Nhận Trả Sách
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-7">Giao dịch đã kết thúc</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-white border border-secondary border-opacity-10 rounded-4 shadow-sm">
                    <i class="fa-solid fa-rotate-left fs-1 text-muted opacity-50 mb-3"></i>
                    <h4 class="text-muted">Chưa có giao dịch mượn trả nào</h4>
                    <p class="text-muted">Các hoạt động mượn sách từ độc giả sẽ hiển thị tại bảng này.</p>
                </div>
            }

        </div>
    </div>
</div>
